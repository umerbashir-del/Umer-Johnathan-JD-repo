{
  "name": "ur-appeals-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:push": "npm run db:migrate",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "test:integration": "tsx --conditions=react-server scripts/backend-integration.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "test:ui:server": "tsx --conditions=react-server e2e/ur1042-server.ts",
    "test:ui:verify": "tsx e2e/verify-ur1042-evidence.ts",
    "test:agent-loop": "tsx --conditions=react-server e2e/agent-loop-errors.ts",
    "test:agent-loop:verify": "tsx e2e/verify-agent-loop.ts",
    "test:roles": "tsx --conditions=react-server e2e/role-permissions.ts",
    "test:role-sessions": "tsx --conditions=react-server e2e/role-sessions.ts",
    "test:security": "tsx --conditions=react-server e2e/security-boundaries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.9.1",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
