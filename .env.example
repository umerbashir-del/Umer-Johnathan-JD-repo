# Keys only. Never put a value in this file; set real values in your local env file or the host.
# Empty means unset for every key.

# Deployment
# APP_DEPLOYMENT=local is required for local dev. Missing or anything else means hosted (fail closed).
# VERCEL, VERCEL_ENV and VERCEL_URL are set by the platform; don't set them yourself.
APP_DEPLOYMENT=
APP_ORIGIN=

# Database
DATABASE_URL=

# Auth
AUTH_SECRET=
DEMO_CREDENTIAL_CLINICIAN_A=

# Model and spend
ANTHROPIC_API_KEY=
MODEL_DEFAULT=
SPEND_LEDGER_URL=
SPEND_DEMO_RESERVE_UNLOCKED=

# Agent replay (flags accept 1 or 0 only)
AGENT_REPLAY=
AGENT_RECORD=
AGENT_REPLAY_DIR=
REPLAY_PRODUCTION_LABELED=

# Features
FREEFORM_UPLOAD_ENABLED=

# Demo clock (ISO 8601 date-time with an explicit offset or Z; unset means real time)
DEMO_NOW=
